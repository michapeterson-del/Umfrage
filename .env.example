# Postgres-Verbindung (Pflicht). Auf Vercel automatisch gesetzt, wenn du eine
# "Postgres"-Datenbank (Vercel Postgres / Neon) im Projekt verknüpfst.
# Für lokale Entwicklung: Verbindungsstring zu einem eigenen/lokalen Postgres.
POSTGRES_URL=postgresql://user:password@localhost:5432/umfrage

# API-Key von https://console.anthropic.com/ — wird verwendet, um aus deiner
# Freitext-Beschreibung automatisch Umfragefragen zu erstellen.
# Ohne diesen Key funktioniert die App trotzdem (einfache Basis-Umfrage ohne KI).
ANTHROPIC_API_KEY=

# Optional: welches Claude-Modell für die Umfrage-Erstellung verwendet wird.
# ANTHROPIC_MODEL=claude-sonnet-5
